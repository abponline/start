{
  "name": "salon-management-software",
  "version": "1.0.0",
  "description": "A comprehensive salon management system for managing customers, appointments, services, and business operations",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "setup-db": "node backend/scripts/setup-database.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "jest backend/tests",
    "test:frontend": "cd frontend && npm test",
    "install:all": "npm install && cd frontend && npm install"
  },
  "keywords": [
    "salon",
    "management",
    "booking",
    "appointments",
    "beauty",
    "business"
  ],
  "author": "ABP Online",
  "license": "Apache-2.0",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.6",
    "sequelize": "^6.32.1",
    "express-validator": "^7.0.1",
    "nodemailer": "^6.9.4",
    "multer": "^1.4.5-lts.1",
    "moment": "^2.29.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.4"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}