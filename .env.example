# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salon_management
DB_USER=salon_user
DB_PASS=salon_password

# SQLite for development (comment out for production)
DATABASE_URL=./database/salon.sqlite

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
FROM_EMAIL=noreply@yoursalon.com
FROM_NAME=Your Salon Name

# Payment Configuration (Stripe example)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Business Configuration
BUSINESS_NAME=Your Salon Name
BUSINESS_ADDRESS=123 Beauty Street, City, State 12345
BUSINESS_PHONE=+1-555-123-4567
BUSINESS_EMAIL=info@yoursalon.com
BUSINESS_WEBSITE=https://yoursalon.com

# Operating Hours (24-hour format)
OPENING_TIME=09:00
CLOSING_TIME=18:00
DAYS_CLOSED=Sunday

# Appointment Configuration
DEFAULT_APPOINTMENT_DURATION=60
BOOKING_ADVANCE_DAYS=30
CANCELLATION_DEADLINE_HOURS=24